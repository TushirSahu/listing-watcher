# Copy to .env and fill in. Pick ONE provider.
LLM_PROVIDER=google             # google | openai | anthropic | ollama
LLM_MODEL=gemini-flash-lite-latest  # a cheap, fast model is enough

GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434   # ollama: best-effort, small models may get lost

# Cap page text sent to the model per step. Helps with free-tier tokens-per-minute limits
# (e.g. Gemini free: 250k/min). Leave unset for the library default.
# LLM_MAX_CONTEXT_CHARS=60000

# Where the web page saves conversations (default ~/.thrift-scout/history.db)
# HISTORY_DB=

# --- Safety ---
# The agent's browser may only open these sites plus the built-in list (Mercari, Yahoo Auctions,
# Rakuma, Amazon.co.jp, SUUMO, HOME'S). Comma-separated; '*.example.jp' includes subdomains.
# ALLOWED_SITES=*.example.jp
# One extra model call per turn that flags pages trying to hijack the agent. Set to off to skip.
# INJECTION_CHECK=on
# Stop after this many agent steps per run (limits spend). Restart to reset.
# MAX_STEPS_PER_RUN=600

# Turn off browser-use's anonymous usage telemetry
ANONYMIZED_TELEMETRY=false
