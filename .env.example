# Copy to .env and fill in. Pick ONE provider.
LLM_PROVIDER=google             # google | openai | anthropic | ollama
LLM_MODEL=gemini-flash-lite-latest  # a cheap, fast model is enough

GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434   # ollama: best-effort, small models may get lost

# Telegram alerts (optional — without these, alerts print to the console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Turn off browser-use's anonymous usage telemetry
ANONYMIZED_TELEMETRY=false
